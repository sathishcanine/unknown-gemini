  "rules": [
    {
      "rule_en": "Subject (S): To get 'Subject' ask the question 'Who?' before the verb. It consists of nouns or pronouns and occurs before a verb.",
      "pattern_topic": "overview",
      "source": "asan",
      "source_page": 40
    },
    {
      "rule_en": "Verb (V): A verb shows an action or activity or work done by the subject. It also tells the status. To get 'verb' ask what does the subject do?",
      "pattern_topic": "overview",
      "source": "asan",
      "source_page": 40
    },
    {
      "rule_en": "Object (O): To get the object, ask the question 'What?' or 'Whom?'. 'What' is for things and 'Whom' is for persons.",
      "pattern_topic": "overview",
      "source": "asan",
      "source_page": 40
    },
    {
      "rule_en": "Direct Object (DO): Direct object answers the question 'what'.",
      "pattern_topic": "overview",
      "source": "asan",
      "source_page": 40
    },
    {
      "rule_en": "Indirect Object (IO): Answers the question 'whom'.",
      "pattern_topic": "overview",
      "source": "asan",
      "source_page": 40
    },
    {
      "rule_en": "Complement (C): The words required to complete the meaning of a sentence are called Complement.",
      "pattern_topic": "overview",
      "source": "asan",
      "source_page": 40
    },
    {
      "rule_en": "Adjunct (A): To get 'Adjunct' ask the question where, how, when or why.",
      "pattern_topic": "overview",
      "source": "asan",
      "source_page": 40
    },
    {
      "rule_en": "Subject + Verb + Object + Complement",
      "pattern_topic": "svoc",
      "source": "asan",
      "source_page": 41
    },
    {
      "rule_en": "Subject + Verb + Indirect Object + Direct Object",
      "pattern_topic": "svoo",
      "source": "asan",
      "source_page": 41
    },
    {
      "rule_en": "Subject + Verb + Complement",
      "pattern_topic": "svc",
      "source": "asan",
      "source_page": 41
    },
    {
      "rule_en": "Subject + Verb + Object + Complement + Adjunct",
      "pattern_topic": "svoc",
      "source": "asan",
      "source_page": 41
    },
    {
      "rule_en": "Subject + Verb + Object + Adjunct",
      "pattern_topic": "svo",
      "source": "asan",
      "source_page": 41
    },
    {
      "rule_en": "Subject + Verb + Complement + Adjunct",
      "pattern_topic": "svc",
      "source": "asan",
      "source_page": 41
    },
    {
      "rule_en": "Adjunct + Subject + Verb",
      "pattern_topic": "sva",
      "source": "asan",
      "source_page": 41
    },
    {
      "rule_en": "Adjunct + Subject + Verb + Object",
      "pattern_topic": "svo",
      "source": "asan",
      "source_page": 41
    },
    {
      "rule_en": "Adjunct + Subject + Verb + Complement",
      "pattern_topic": "svc",
      "source": "asan",
      "source_page": 41
    },
    {
      "rule_en": "Adjunct + Subject + Indirect Object + Direct Object",
      "pattern_topic": "svoo",
      "source": "asan",
      "source_page": 41
    },
    {
      "rule_en": "Direct Object (DO): Answers the question 'what'. Indirect Object (IO): Answers the question 'whom'.",
      "pattern_topic": "svoo",
      "source": "grammer",
      "source_page": 451
    },
    {
      "rule_en": "Complement (C): The words required to complete the meaning of a sentence. Object complement answers 'how' asked on the object.",
      "pattern_topic": "svc",
      "source": "grammer",
      "source_page": 451
    },
    {
      "rule_en": "To get 'Adjunct' (A), ask the question: where, how, when, or why.",
      "pattern_topic": "sva",
      "source": "grammer",
      "source_page": 452
    },
    {
      "rule_en": "Subject (S): The person who does the action in the sentence.",
      "pattern_topic": "sv",
      "source": "govt",
      "source_page": 72
    },
    {
      "rule_en": "Verb (V): A word that indicates action, state of being, or possession.",
      "pattern_topic": "sv",
      "source": "govt",
      "source_page": 72
    },
    {
      "rule_en": "Complement (C): The word or phrase which completes the meaning of the sentence.",
      "pattern_topic": "svc",
      "source": "govt",
      "source_page": 72
    },
    {
      "rule_en": "Complement usually follows 'be' verbs (am, is, are, was, were) or verbs like become, turn, look, appear, feel.",
      "pattern_topic": "svc",
      "source": "govt",
      "source_page": 72
    },
    {
      "rule_en": "In SVOC patterns, complement can be identified by raising the question 'as what?'",
      "pattern_topic": "svoc",
      "source": "govt",
      "source_page": 73
    },
    {
      "rule_en": "The object is the word which receives the action from the subject.",
      "pattern_topic": "svo",
      "source": "govt",
      "source_page": 73
    },
    {
      "rule_en": "Direct object (DO) answers 'what'; Indirect object (IO) answers 'to whom'.",
      "pattern_topic": "svoo",
      "source": "govt",
      "source_page": 73
    },
    {
      "rule_en": "An adjunct (A) provides answers to the questions: 'How', 'When', 'Why' or 'Where'.",
      "pattern_topic": "sva",
      "source": "govt",
      "source_page": 73
    },
    {
      "rule_en": "S + V: Raju woke up.",
      "pattern_topic": "sv",
      "source": "govt",
      "source_page": 74
    },
    {
      "rule_en": "S + V + O: He wore his new uniform.",
      "pattern_topic": "svo",
      "source": "govt",
      "source_page": 74
    },
    {
      "rule_en": "S + V + IO + DO: His father gave him his school bag.",
      "pattern_topic": "svoo",
      "source": "govt",
      "source_page": 74
    },
    {
      "rule_en": "S + V + C: He was excited.",
      "pattern_topic": "svc",
      "source": "govt",
      "source_page": 74
    },
    {
      "rule_en": "S + V + O + C: Reading made him a complete man.",
      "pattern_topic": "svoc",
      "source": "govt",
      "source_page": 74
    },
    {
      "rule_en": "S + V + A: He was going to school.",
      "pattern_topic": "sva",
      "source": "govt",
      "source_page": 74
    }
  ],
