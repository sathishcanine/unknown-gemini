  "rules": [
    {
      "rule_en": "A group of words, which gives complete sense is called a sentence.",
      "sentence_topic": "overview",
      "source": "asan",
      "source_page": 40
    },
    {
      "rule_en": "A question tag is a short question added at the end of a statement to ask for agreement or confirmation.",
      "sentence_topic": "other",
      "source": "asan",
      "source_page": 44
    },
    {
      "rule_en": "A positive statement takes a negative tag, while a negative statement takes a positive tag.",
      "sentence_topic": "other",
      "source": "asan",
      "source_page": 44
    },
    {
      "rule_en": "Question tags are formed with the auxiliary or modal verb from the statement + n't + pronoun.",
      "sentence_topic": "other",
      "source": "asan",
      "source_page": 44
    },
    {
      "rule_en": "Declarative (D) sentences make a statement.",
      "sentence_topic": "statement_assertive",
      "source": "grammer",
      "source_page": 60
    },
    {
      "rule_en": "Interrogative (In) sentences ask a question.",
      "sentence_topic": "interrogative",
      "source": "grammer",
      "source_page": 60
    },
    {
      "rule_en": "Exclamatory (E) sentences express strong emotion.",
      "sentence_topic": "exclamatory",
      "source": "grammer",
      "source_page": 60
    },
    {
      "rule_en": "Imperative (Im) sentences issue a command or request.",
      "sentence_topic": "imperative",
      "source": "grammer",
      "source_page": 60
    },
    {
      "rule_en": "Every sentence begins with a capital letter.",
      "sentence_topic": "overview",
      "source": "grammer",
      "source_page": 137
    },
    {
      "rule_en": "Assertive and imperative sentences end with a full-stop or a period.",
      "sentence_topic": "statement_assertive",
      "source": "grammer",
      "source_page": 137
    },
    {
      "rule_en": "Sentences that ask something end with a question mark.",
      "sentence_topic": "interrogative",
      "source": "grammer",
      "source_page": 137
    },
    {
      "rule_en": "Sentences that express excitement or strong feelings end with an exclamatory mark.",
      "sentence_topic": "exclamatory",
      "source": "grammer",
      "source_page": 137
    },
    {
      "rule_en": "Falling tone is used in declarative sentences (statements) which are categorical, confident, and convincing.",
      "sentence_topic": "statement_assertive",
      "source": "grammer",
      "source_page": 453
    },
    {
      "rule_en": "Falling tone is used for 'Wh-' questions.",
      "sentence_topic": "interrogative",
      "source": "grammer",
      "source_page": 453
    },
    {
      "rule_en": "Falling tone is used in imperative sentences (commands).",
      "sentence_topic": "imperative",
      "source": "grammer",
      "source_page": 453
    },
    {
      "rule_en": "Falling tone is used in exclamatory sentences.",
      "sentence_topic": "exclamatory",
      "source": "grammer",
      "source_page": 453
    },
    {
      "rule_en": "Rising intonation is used for Yes/No (Polar) questions.",
      "sentence_topic": "interrogative",
      "source": "grammer",
      "source_page": 453
    },
    {
      "rule_en": "Rising intonation is used for exclamations intended to be a question.",
      "sentence_topic": "exclamatory",
      "source": "grammer",
      "source_page": 453
    },
    {
      "rule_en": "For Affirmative Imperative sentence we use will you or won’t you in the question tag.",
      "sentence_topic": "imperative",
      "source": "govt",
      "source_page": 45
    },
    {
      "rule_en": "For Negative Imperative sentence we use will you as the question tag.",
      "sentence_topic": "imperative",
      "source": "govt",
      "source_page": 45
    },
    {
      "rule_en": "For Imperative sentences beginning with let us, when a suggestion or proposal is being made the question tag will be shall we.",
      "sentence_topic": "imperative",
      "source": "govt",
      "source_page": 45
    },
    {
      "rule_en": "For Imperative sentences beginning with let but not followed by us, the question tag will be will you.",
      "sentence_topic": "imperative",
      "source": "govt",
      "source_page": 45
    },
    {
      "rule_en": "In exclamatory sentences the question tag will contain the auxiliary verbs.",
      "sentence_topic": "exclamatory",
      "source": "govt",
      "source_page": 46
    }
  ],
