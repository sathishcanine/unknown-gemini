{
  "subject_id": "English",
  "unit": "Vocabulary",
  "menu": "abbreviations",
  "sources": [
    "Vetrii Vocabulary pp.[165, 166, 167, 168, 169, 170] (primary, vision)",
    "Grammer.pdf pp.[345, 346, 347, 348, 351, 353] (secondary)"
  ],
  "rules": [
    {
      "rule_en": "An abbreviation is a shortened form of a word or phrase.",
      "ab_tag": "definition",
      "source": "grammer",
      "source_page": 345
    },
    {
      "rule_en": "An acronym is a shortened form of a phrase usually made up of the initial letters of that phrase.",
      "ab_tag": "definition",
      "source": "grammer",
      "source_page": 346
    },
    {
      "rule_en": "Abbreviation refers to any shortened or contracted form of a word or phrase.",
      "ab_tag": "definition",
      "source": "grammer",
      "source_page": 347
    },
    {
      "rule_en": "Acronym is a type of abbreviation formed from the first letters of a series of words and pronounced as a separate word.",
      "ab_tag": "definition",
      "source": "grammer",
      "source_page": 347
    },
    {
      "rule_en": "All acronyms are abbreviations, but not every abbreviation is an acronym.",
      "ab_tag": "overview",
      "source": "grammer",
      "source_page": 347
    },
    {
      "rule_en": "Abbreviations are shortened forms of words or phrases, often formed by taking the initial letters of words or specific mathematical unit symbols.",
      "ab_tag": "definition",
      "source": "grammer",
      "source_page": 348
    },
    {
      "rule_en": "Abbreviations are shortened forms of words or phrases, often representing names of organizations, technologies, or technical terms.",
      "ab_tag": "definition",
      "source": "grammer",
      "source_page": 351
    },
    {
      "rule_en": "Abbreviations are shortened forms of words or phrases, often formed by taking the initial letters of each word in the phrase.",
      "ab_tag": "definition",
      "source": "grammer",
      "source_page": 353
    }
  ],
