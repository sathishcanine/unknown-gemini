  "rules": [
    {
      "rule_en": "A collocation is a term where two or more words often go well together.",
      "col_tag": "definition",
      "source": "vetrii",
      "source_page": 83
    },
    {
      "rule_en": "These combinations sound right to native speakers; unnatural combinations sound wrong.",
      "col_tag": "overview",
      "source": "vetrii",
      "source_page": 83
    },
    {
      "rule_en": "Verb collocations are those types of collocations that are used extensively and tend to involve a verb + noun phrase in the day to day situations.",
      "col_tag": "definition",
      "source": "vetrii",
      "source_page": 84
    },
    {
      "rule_en": "When you add adjectives with nouns and adverbs, it forms adjective collocations.",
      "col_tag": "definition",
      "source": "vetrii",
      "source_page": 84
    },
    {
      "rule_en": "Collocations are natural word partnerships that frequently go together in English.",
      "col_tag": "definition",
      "source": "vetrii",
      "source_page": 441
    }
  ],
