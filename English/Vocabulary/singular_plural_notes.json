  "rules": [
    {
      "rule_en": "Replace 'is' with 'es' for certain nouns.",
      "sp_tag": "other",
      "source": "grammer",
      "source_page": 387
    },
    {
      "rule_en": "Replace 'um' with 'a' for certain nouns.",
      "sp_tag": "other",
      "source": "grammer",
      "source_page": 387
    },
    {
      "rule_en": "Replace 'us' with 'i' for certain nouns.",
      "sp_tag": "other",
      "source": "grammer",
      "source_page": 387
    },
    {
      "rule_en": "Change the internal vowels of the noun.",
      "sp_tag": "irregular",
      "source": "grammer",
      "source_page": 387
    },
    {
      "rule_en": "Add 's' to the first word in hyphenated nouns.",
      "sp_tag": "compound",
      "source": "grammer",
      "source_page": 387
    },
    {
      "rule_en": "Nouns that have the same form for both singular and plural.",
      "sp_tag": "zero",
      "source": "grammer",
      "source_page": 387
    },
    {
      "rule_en": "Change the singular nouns to plurals by adding 's'",
      "sp_tag": "regular",
      "source": "grammer",
      "source_page": 389
    },
    {
      "rule_en": "Change the singular nouns to plurals by adding 'ies'",
      "sp_tag": "regular",
      "source": "grammer",
      "source_page": 389
    },
    {
      "rule_en": "Change the singular nouns to plurals by adding 'es'",
      "sp_tag": "regular",
      "source": "grammer",
      "source_page": 389
    },
    {
      "rule_en": "Change the singular nouns to plurals by adding 'ves'",
      "sp_tag": "regular",
      "source": "grammer",
      "source_page": 389
    },
    {
      "rule_en": "Some nouns retain the same form in the singular and plural.",
      "sp_tag": "zero",
      "source": "govt",
      "source_page": 100
    },
    {
      "rule_en": "Most compound nouns form their plural with an addition of ‘s’.",
      "sp_tag": "compound",
      "source": "govt",
      "source_page": 100
    },
    {
      "rule_en": "In some compound nouns, the plural is formed by adding 's' to the first part of the compound word.",
      "sp_tag": "compound",
      "source": "govt",
      "source_page": 101
    },
    {
      "rule_en": "In some compound nouns, the plural is formed by converting both the parts in the compound word.",
      "sp_tag": "compound",
      "source": "govt",
      "source_page": 101
    },
    {
      "rule_en": "Some nouns are always plural and have no singular forms.",
      "sp_tag": "always_plural",
      "source": "govt",
      "source_page": 101
    }
  ],
