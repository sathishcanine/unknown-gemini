  "rules": [
    {
      "rule_en": "Words in English are not always spelt as they are pronounced. About 75% of English words follow basic spelling rules, while the rest are exceptions.",
      "sp_tag": "overview",
      "source": "vetrii",
      "source_page": 108
    },
    {
      "rule_en": "Improve spelling skills by: playing word games, splitting long words into chunks, learning syllabification, memorising lists of tricky words, and knowing the rules of spelling.",
      "sp_tag": "definition",
      "source": "vetrii",
      "source_page": 108
    },
    {
      "rule_en": "When a suffix is added to words ending in silent 'e', the letter 'e' is normally dropped before a vowel.",
      "sp_tag": "definition",
      "source": "vetrii",
      "source_page": 109
    },
    {
      "rule_en": "The final 'e' is not normally dropped before a consonant.",
      "sp_tag": "definition",
      "source": "vetrii",
      "source_page": 109
    },
    {
      "rule_en": "Words ending in 'ce' or 'ge' retain the 'e' before a suffix beginning with 'a', 'o', or 'u'.",
      "sp_tag": "definition",
      "source": "vetrii",
      "source_page": 109
    },
    {
      "rule_en": "In words ending in a consonant + 'y', the letter 'y' changes to 'ie' before 's' and to 'i' before -ed, -es, -er, -est, and -ly.",
      "sp_tag": "definition",
      "source": "vetrii",
      "source_page": 109
    },
    {
      "rule_en": "The letter 'y' does not change if it comes after a vowel letter.",
      "sp_tag": "definition",
      "source": "vetrii",
      "source_page": 109
    },
    {
      "rule_en": "The letter 'y' in the end does not change before -ing.",
      "sp_tag": "definition",
      "source": "vetrii",
      "source_page": 109
    },
    {
      "rule_en": "The final 'ie' changes to 'y' before -ing.",
      "sp_tag": "definition",
      "source": "vetrii",
      "source_page": 109
    },
    {
      "rule_en": "A final 'y' following a consonant changes to 'i' before any suffix except 'ing'.",
      "sp_tag": "definition",
      "source": "vetrii",
      "source_page": 109
    },
    {
      "rule_en": "When adding a suffix to a word ending in a consonant + y, change y to i.",
      "sp_tag": "definition",
      "source": "vetrii",
      "source_page": 110
    },
    {
      "rule_en": "In short words ending in one vowel letter + one consonant letter, the consonant is doubled before an ending with a vowel (ed, ing, er, est).",
      "sp_tag": "definition",
      "source": "vetrii",
      "source_page": 110
    },
    {
      "rule_en": "In longer words, the final syllable is doubled if the last part of the word is stressed.",
      "sp_tag": "definition",
      "source": "vetrii",
      "source_page": 110
    },
    {
      "rule_en": "The consonant is not doubled if the last part of the word is unstressed.",
      "sp_tag": "definition",
      "source": "vetrii",
      "source_page": 110
    },
    {
      "rule_en": "If words end with 'l', the letter 'l' is doubled in British English even if the last part is unstressed.",
      "sp_tag": "definition",
      "source": "vetrii",
      "source_page": 110
    },
    {
      "rule_en": "If a word ending in 'll' takes the suffix '-ful', one 'l' is dropped in British English.",
      "sp_tag": "definition",
      "source": "vetrii",
      "source_page": 110
    },
    {
      "rule_en": "When 'ie' or 'ei' is pronounced like 'ee' in 'bee', 'i' comes before 'e' except after 'c'.",
      "sp_tag": "definition",
      "source": "vetrii",
      "source_page": 110
    },
    {
      "rule_en": "If in doubt about ie or ei, when the sound of the vowel is as in brief /i:/, we spell it ie; but after the letter c, we spell it ei.",
      "sp_tag": "overview",
      "source": "vetrii",
      "source_page": 466
    },
    {
      "rule_en": "The ie/ei rule does not apply to those words where the two vowels 'ei' are not pronounced like 'ee' as in 'bee'. Eg. height / weight / neighbour / leisure / fiery / friend.",
      "sp_tag": "overview",
      "source": "vetrii",
      "source_page": 466
    },
    {
      "rule_en": "'oi' is used in the middle of a word and 'oy' is used at the end of a word.",
      "sp_tag": "overview",
      "source": "vetrii",
      "source_page": 466
    },
    {
      "rule_en": "'ou' is used in the middle of a word, whereas 'ow' is used at the end of words, except those that end in letter 'n' or letter 'd'.",
      "sp_tag": "overview",
      "source": "vetrii",
      "source_page": 466
    },
    {
      "rule_en": "We add -es to some words ending in -o (e.g., tomato -> tomatoes, echo -> echoes). However, some words ending in -o only require -s: videos, discos, pianos, memos, photos.",
      "sp_tag": "overview",
      "source": "vetrii",
      "source_page": 466
    },
    {
      "rule_en": "When there is a prefix, we do not normally add or take away more letters.",
      "sp_tag": "overview",
      "source": "vetrii",
      "source_page": 112
    },
    {
      "rule_en": "Use prefix 'il-' before 'l', 'im-' before 'm' or 'p', and 'ir-' before 'r'.",
      "sp_tag": "overview",
      "source": "vetrii",
      "source_page": 112
    },
    {
      "rule_en": "The general rule for plurals of regular nouns and -s forms of regular verbs is to add -s.",
      "sp_tag": "overview",
      "source": "vetrii",
      "source_page": 112
    },
    {
      "rule_en": "If the ending is pronounced as 'ch' or 's', we add -es.",
      "sp_tag": "overview",
      "source": "vetrii",
      "source_page": 112
    },
    {
      "rule_en": "If a word ends in an -e, we add an -s to form the plural.",
      "sp_tag": "overview",
      "source": "vetrii",
      "source_page": 112
    },
    {
      "rule_en": "For some nouns ending in -f or -fe, we form the plural by changing the -f or -fe to -ves.",
      "sp_tag": "definition",
      "source": "vetrii",
      "source_page": 113
    },
    {
      "rule_en": "We often double the final consonant of a word (b, d, g, l, m, n, p, r, t) when a suffix beginning with a vowel is added (-ed, -er, -est, -ing).",
      "sp_tag": "definition",
      "source": "vetrii",
      "source_page": 113
    },
    {
      "rule_en": "If a word ends in -s, -ss, -ch, -sh, -x, -z, we add -es to form plural or verb-s forms.",
      "sp_tag": "overview",
      "source": "grammer",
      "source_page": 443
    },
    {
      "rule_en": "If the word ends in a consonant plus -y, change -y to i and add -es.",
      "sp_tag": "overview",
      "source": "grammer",
      "source_page": 443
    },
    {
      "rule_en": "For words ending in -o, add -es, except for some words like videos, discos, pianos, memos, photos which add -s.",
      "sp_tag": "overview",
      "source": "grammer",
      "source_page": 443
    },
    {
      "rule_en": "Nouns ending in -f or -fe often form plurals by changing -f or -fe to -ves.",
      "sp_tag": "overview",
      "source": "grammer",
      "source_page": 443
    },
    {
      "rule_en": "Double the final consonant (b, d, g, l, m, n, p, r, t) when a suffix beginning with a vowel is added, if the stress is on the final syllable.",
      "sp_tag": "overview",
      "source": "grammer",
      "source_page": 443
    },
    {
      "rule_en": "Drop the final -e when a suffix beginning with a vowel is added to a word.",
      "sp_tag": "overview",
      "source": "grammer",
      "source_page": 443
    },
    {
      "rule_en": "When adding a suffix to a word ending in a consonant + -y, change -y to i, except in cases like day+ly=daily.",
      "sp_tag": "overview",
      "source": "grammer",
      "source_page": 443
    },
    {
      "rule_en": "I before E except after C: lieing becomes lying, believe is correct.",
      "sp_tag": "other",
      "source": "grammer",
      "source_page": 444
    },
    {
      "rule_en": "In short words ending in one vowel + one consonant, the consonant is doubled before an ending with a vowel (-ed, -ing, -er, -est).",
      "sp_tag": "overview",
      "source": "grammer",
      "source_page": 446
    },
    {
      "rule_en": "In longer words, the final consonant is doubled if the last syllable is stressed.",
      "sp_tag": "overview",
      "source": "grammer",
      "source_page": 446
    },
    {
      "rule_en": "If a word ends in 'l', the letter 'l' is doubled in British English even if the syllable is unstressed (e.g., travelled). Exception: paralleled.",
      "sp_tag": "overview",
      "source": "grammer",
      "source_page": 446
    },
    {
      "rule_en": "If a word ending in 'll' takes the suffix '-ful', one 'l' is dropped (e.g., skilful).",
      "sp_tag": "overview",
      "source": "grammer",
      "source_page": 446
    },
    {
      "rule_en": "Final 'e' is retained before '-able' or '-ous' to keep 'c' or 'g' soft (e.g., changeable, courageous).",
      "sp_tag": "overview",
      "source": "grammer",
      "source_page": 446
    },
    {
      "rule_en": "In words ending in consonant + 'y', 'y' changes to 'ie' before '-s' and to 'i' before '-ed', '-er', '-est', '-ly'.",
      "sp_tag": "overview",
      "source": "grammer",
      "source_page": 446
    },
    {
      "rule_en": "Final 'ie' changes to 'y' before '-ing' (e.g., dying, lying).",
      "sp_tag": "overview",
      "source": "grammer",
      "source_page": 446
    },
    {
      "rule_en": "When 'ie' or 'ei' is pronounced like 'ee', 'i' comes before 'e' except after 'c'. Exceptions include seize, surfeit, protein.",
      "sp_tag": "overview",
      "source": "grammer",
      "source_page": 447
    },
    {
      "rule_en": "The 'ie' vs 'ei' rule does not apply when the sounds are not pronounced like 'ee' (e.g., height, weight, neighbour).",
      "sp_tag": "overview",
      "source": "grammer",
      "source_page": 447
    },
    {
      "rule_en": "'ou' is used in the middle of a word; 'ow' is used at the end, except when the word ends in 'n' or 'd'.",
      "sp_tag": "overview",
      "source": "grammer",
      "source_page": 447
    }
  ],
